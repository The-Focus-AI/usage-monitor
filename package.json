{
  "name": "usage-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/main.ts",
    "check": "tsx src/cli/main.ts",
    "setup": "tsx src/tui/setup.tsx",
    "setup-cli": "tsx src/setup-cli.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "legacy": "node scripts/check-balance.mjs",
    "server": "tsx src/server/main.ts",
    "server:dev": "tsx watch src/server/main.ts",
    "dashboard:dev": "cd src/server/dashboard && pnpm dev",
    "dashboard:build": "cd src/server/dashboard && pnpm build",
    "status": "tsx src/cli/status.ts",
    "status:json": "tsx src/cli/status.ts --json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "ink": "^6.2.3",
    "ink-search-select": "^1.1.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "node-cron": "^4.2.1",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@clerk/fastify": "^3.1.22",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@vitest/ui": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
